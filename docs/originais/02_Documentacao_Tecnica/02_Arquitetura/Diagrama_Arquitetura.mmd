 subgraph Cliente["1. Usuários do Sistema"]
        UserPub["Visitante / Adotante"]
        UserAdmin["Voluntário / Administrador"]
  end
 subgraph FrontendLayer["2. Front-end - Interface do Usuário"]
        ReactApp["Aplicação Web em React.js<br>• Portal Público<br>• Tela de Login Administrativo<br>• Painel de Gestão e Publicação de Postagens<br>• Widget Flutuante de Captura de E-mails<br>• Módulo de Leitura e Envio de CSV"]
  end
 subgraph BackendLayer["3. Back-end - Servidor na Nuvem Azure"]
